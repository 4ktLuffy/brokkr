# qwen3.5:9b with a 32K context window (Ollama's default would truncate at 4K;
# see scripts/probe-context.py). Its hybrid attention keeps a KV cache on only
# 8 of 32 layers (4 KV heads x 256 dims), about 32 KB per token, so 32K of
# context costs about 1 GB on top of the 6.6 GB of weights.
#
#   ollama create brokkr-qwen3.5-9b-32k -f dev/ollama/qwen3.5-9b-32k.Modelfile
FROM qwen3.5:9b
PARAMETER num_ctx 32768
